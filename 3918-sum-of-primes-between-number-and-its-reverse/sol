class Solution {
    public int sumOfPrimesInRange(int n) {
        int num = n;
        int rev = 0;
        while(n != 0){
            int x = n % 10;
            rev = rev * 10 + x;
            n /= 10;
        }
        n = num;
        int sum = 0;
        int min = Math.min(n, rev);
        int max = Math.max(n, rev);
        for(int i = min; i <= max; i++){
            if(isPrime(i)) sum += i;
        }
        return sum;
    }
    public boolean isPrime(int x){
        if(x <= 1) return false;
        for(int i = 2; i*i <= x; i++){
            if(x % i == 0) return false;
        }
        return true;
    }
}
