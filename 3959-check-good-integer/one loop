class Solution {
    public boolean checkGoodInteger(int n) {
        int n1=n;
        int digitSum=0;
        int squareSum=0;
        while(n1>0){
            int digit=n1%10;
            n1/=10;
            digitSum+=digit;
            squareSum+=digit*digit;
        }
        return squareSum-digitSum>=50;
        
    }
}
